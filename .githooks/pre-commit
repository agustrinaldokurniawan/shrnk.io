#!/bin/sh
FILE="README.md"

if git diff --cached --name-only | grep -q "^${FILE}$"; then
    BRANCH=$(git rev-parse --abbrev-ref HEAD)
    DATE=$(date +"%Y-%m-%d %H:%M:%S")

    # Cross-platform sed (works on Windows Git Bash, macOS, and Linux)
    TMP_FILE=$(mktemp)
    sed "s/{{GIT_BRANCH}}/${BRANCH}/g; s/{{GIT_DATE}}/${DATE}/g" "$FILE" > "$TMP_FILE" && mv "$TMP_FILE" "$FILE"

    git add "$FILE"
fi